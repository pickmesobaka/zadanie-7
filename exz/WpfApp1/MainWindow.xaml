<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="userTable" ColumnWidth="*" AutoGenerateColumns="False" SelectionChanged="userTable_SelectionChanged" Margin="0,66,0,-66">
            <DataGrid.CellStyle>
                <Style/>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding IdПользователя}" Header="ID_пользователя"/>
                <DataGridTextColumn Binding="{Binding Фио}" Header="Фио"/>
                <DataGridTextColumn Binding="{Binding Логин}" Header="Логин"/>
                <DataGridTextColumn Binding="{Binding Пароль}" Header="Пароль"/>
            </DataGrid.Columns>

        </DataGrid>
        <Button x:Name="SearchButton" Content="Button" HorizontalAlignment="Left" Margin="537,23,0,0" VerticalAlignment="Top" Height="27" Width="90" RenderTransformOrigin="0.601,-3.578" Click="SearchButton_Click"/>
        <TextBox x:Name="SearchBox" HorizontalAlignment="Left" Height="27" Margin="103,23,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="415" TextChanged="TextBox_TextChanged"/>
        <TextBlock x:Name="authTextBlock" HorizontalAlignment="Left" Height="26" Margin="674,0,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="116"/>

    </Grid>
</Window>
