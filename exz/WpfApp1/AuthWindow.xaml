<Window x:Class="WpfApp1.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="AuthWindow" Height="450" Width="800">
    <Grid Margin="0,0,322,0">
        <TextBox x:Name="PasswordTextBox" HorizontalAlignment="Left" Height="40" Margin="250,159,0,0" TextWrapping="Wrap" Text="пароль" VerticalAlignment="Top" Width="150" TextChanged="TextBox_TextChanged"/>
        <TextBox x:Name="LoginTextBox" HorizontalAlignment="Left" Height="40" Margin="250,94,0,0" TextWrapping="Wrap" Text="логин" VerticalAlignment="Top" Width="150" Background="White"/>
        <Button x:Name="authButton" Content="войти" HorizontalAlignment="Left" Height="45" Margin="250,217,0,0" VerticalAlignment="Top" Width="150" Click="authButton_Click"/>

    </Grid>
</Window>
